{
  "name": "desk-pulse",
  "version": "1.1.0",
  "description": "DeskPulse is a transparent, frameless, always-on-top desktop system monitor widget for Windows. Shows CPU, memory, disks, network, GPU, battery and clock, with light/dark themes, tray controls and launch-at-login.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --publish never",
    "build:dir": "electron-builder --win --dir --publish never"
  },
  "keywords": [
    "electron",
    "desktop-widget",
    "system-monitor",
    "desk-pulse",
    "windows",
    "always-on-top",
    "system-tray"
  ],
  "author": "Lava",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/LavaIT/DeskPulse.git"
  },
  "bugs": {
    "url": "https://github.com/LavaIT/DeskPulse/issues"
  },
  "homepage": "https://github.com/LavaIT/DeskPulse#readme",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {
    "systeminformation": "^5.21.0"
  },
  "build": {
    "appId": "com.lava.deskpulse",
    "productName": "DeskPulse",
    "copyright": "Copyright © Lava (MIT License)",
    "publish": null,
    "directories": {
      "output": "build-output"
    },
    "files": [
      "main.js",
      "i18n.js",
      "locales/**/*",
      "index.html",
      "renderer.js",
      "style.css",
      "settings.html",
      "about.html",
      "assets/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": ["nsis", "portable"],
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "installerLanguages": ["zh_CN", "en_US"]
    }
  }
}
